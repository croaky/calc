#!/bin/bash
# Pre-push hook: run the Go checks from the Checkfile before a push.
# Install once per clone with `git config core.hooksPath bin`.

set -euo pipefail

# A first push has no origin/main, and a root commit has no HEAD~1.
# Then every tracked file counts as changed.
changed=$(git diff --name-only origin/main...HEAD 2>/dev/null ||
  git diff --name-only HEAD~1...HEAD 2>/dev/null ||
  git ls-files)

if ! grep -q '\.go$' <<<"$changed"; then
  exit 0
fi

goimports="golang.org/x/tools/cmd/goimports@v0.45.0"
deadcode="golang.org/x/tools/cmd/deadcode@v0.45.0"

echo "==> goimports"
out=$(go run "$goimports" -local "$(go list -m)" -l .)
test -z "$out" || { echo "$out"; exit 1; }

echo "==> go vet"
go vet ./...

echo "==> go test"
go test -race ./...

echo "==> deadcode"
out=$(go run "$deadcode" -test ./...)
test -z "$out" || { echo "$out"; exit 1; }

echo "==> gopls check"
out=$(git ls-files -z '*.go' | xargs -0 gopls check -severity=hint)
test -z "$out" || { echo "$out"; exit 1; }
